PORT=4001
NODE_ENV=development

# ---------------- Neon Postgres ----------------
# Pooled connection (used by the app at runtime) - Neon dashboard -> "Pooled connection"
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&pgbouncer=true"
# Direct connection (used by Prisma Migrate, bypasses the pooler) - Neon dashboard -> "Direct connection"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# ---------------- JWT ----------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ---------------- Password reset ----------------
# Frontend page that shows the "new password" form. The link in the email is  <this URL>?token=...
FRONTEND_RESET_URL="http://localhost:3000/reset-password"
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_COOLDOWN_SECONDS=60
APP_NAME="Library System"

# ---------------- Email (SMTP) ----------------
# Gmail: turn on 2-Step Verification, then create an "App Password"
#        (Google Account -> Security -> App passwords). Use that 16-character
#        password below, NOT your normal Gmail password.
# Leave SMTP_USER / SMTP_PASS empty in development to print emails to the console instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Library System <your-account@gmail.com>"




